backend/.venv/
backend/__pycache__/
backend/**/__pycache__/
backend/*.egg-info/
backend/.pytest_cache/
backend/.ruff_cache/
backend/.env
backend/src/*.egg-info/

# Frontend (Node/React)
frontend/node_modules/
frontend/dist/
frontend/coverage/
frontend/.env
frontend/.env.local
frontend/tsconfig.tsbuildinfo

# Universal
.DS_Store
Thumbs.db
*.log
