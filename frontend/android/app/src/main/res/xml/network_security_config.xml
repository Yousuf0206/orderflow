<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only, system CAs only (spec 007 R11). Debug builds override this
     from src/debug/ for live reload; release builds never talk plain HTTP. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
