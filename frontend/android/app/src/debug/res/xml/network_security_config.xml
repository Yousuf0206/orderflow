<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: replaces src/main's HTTPS-only config so live reload
     (npm run cap:dev) can reach the local Vite server over plain HTTP.
     Release builds use src/main/res/xml/network_security_config.xml. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
